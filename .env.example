# OPENAI_API_KEY for GPT-4o models
OPENAI_API_KEY=sk-...

# GROQ_API_KEY for Llama 3.1 models
GROQ_API_KEY=gsk-...

# GEMINI_API_KEY for Gemini models
GEMINI_API_KEY=AIza...

# Environment
NODE_ENV=development

# Server Port
PORT=3000

# Optional: Anthropic API Key (stub implementation)
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Mistral API Key (stub implementation)
# MISTRAL_API_KEY=...

# Optional: DeepSeek API Key (stub implementation)
# DEEPSEEK_API_KEY=...

# Optional: OpenRouter API Key (stub implementation)
# OPENROUTER_API_KEY=...
